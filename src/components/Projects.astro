---
import { projects } from "../assets/projects.ts";
import Card from "./Card.astro";
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mx-6 lg:mx-54 mt-2">
  {
    projects.map((project) => (
      <Card
        title={project.name}
        description={project.description}
        image={project.image}
        links={project.links ?? []}
        techs={project.techs ?? []}
      />
    ))
  }
</div>
